{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=marks_db;Username=marks_user;Password=example_db_password"
  },
  "Jwt": {
    "Key": "example-jwt-secret-key-replace-with-at-least-32-chars-long-secret",
    "Issuer": "MarksApi",
    "Audience": "MarksApiUsers",
    "ExpiryMinutes": 60
  },
  "Marking": {
    "PassMark": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
